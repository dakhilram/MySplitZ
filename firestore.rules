rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MySplitZ intentionally has no login. This open rule means anyone who can
    // reach this Firebase project may be able to read or change its data.
    // Firebase web configuration is not secret, and a hidden GitHub Pages URL
    // or client-side code does not protect Firestore. Add Firebase Authentication
    // and replace this rule with strict authorization before storing sensitive data.
    match /{document=**} { allow read, write: if true; }
  }
}
